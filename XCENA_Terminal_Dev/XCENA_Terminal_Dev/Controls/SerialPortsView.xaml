<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="XCENA_Terminal_Dev.Controls.SerialPortsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:XCENA_Terminal_Dev.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="4,2,2,6" ColumnSpacing="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="Serial ports" />

            <Button x:Name="RefreshButton"
                    Grid.Column="1"
                    Width="28"
                    Height="26"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTipService.ToolTip="Rescan"
                    Click="OnRefreshClick">
                <FontIcon Glyph="&#xE72C;" FontSize="13" />
            </Button>
        </Grid>

        <ListView x:Name="PortList"
                  Grid.Row="1"
                  SelectionMode="Single"
                  SelectionChanged="OnSelectionChanged"
                  DoubleTapped="OnListDoubleTapped">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:SerialPortItem">
                    <StackPanel Padding="4,6" Spacing="1">
                        <TextBlock Text="{x:Bind PortName}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Detail}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock x:Name="EmptyState"
                   Grid.Row="1"
                   Margin="12"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="No serial ports found. Plug in an adapter and rescan." />

        <!-- 115200 8N1 covers almost every board console; the rest is here for the ones it does not. -->
        <StackPanel Grid.Row="2" Margin="4,6,2,0" Spacing="6">
            <ComboBox x:Name="BaudBox"
                      Header="Baud rate"
                      HorizontalAlignment="Stretch"
                      SelectionChanged="OnSettingChanged" />

            <!-- Stacked, not side by side: the panel can be narrow enough to clip "None" to "Nc". -->
            <ComboBox x:Name="FormatBox"
                      Header="Data bits, parity, stop"
                      HorizontalAlignment="Stretch"
                      SelectionChanged="OnSettingChanged" />

            <ComboBox x:Name="FlowBox"
                      Header="Flow control"
                      HorizontalAlignment="Stretch"
                      SelectionChanged="OnSettingChanged" />
        </StackPanel>

        <Button x:Name="OpenButton"
                Grid.Row="3"
                Margin="4,8,2,2"
                HorizontalAlignment="Stretch"
                IsEnabled="False"
                Style="{StaticResource AccentButtonStyle}"
                Click="OnOpenClick">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE839;" FontSize="13" />
                <TextBlock x:Name="OpenLabel" Text="Open port" />
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
