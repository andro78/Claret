<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="XCENA_Terminal_Dev.Controls.RemoteFilesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:XCENA_Terminal_Dev.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        WinUI paints a selected tree row with 3.5% black (#09000000), which disappears against the
        pane. Selection is how you know where an upload will land, so it is worth seeing: these
        replace the row fills with the burgundy accent, deep enough to read at a glance.
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="TreeViewItemBackgroundSelected" Color="#4D8C2332" />
                    <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPointerOver" Color="#668C2332" />
                    <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPressed" Color="#808C2332" />
                    <SolidColorBrush x:Key="TreeViewItemBackgroundPointerOver" Color="#1F8C2332" />
                    <SolidColorBrush x:Key="TreeViewItemBackgroundPressed" Color="#2E8C2332" />
                    <!-- The indicator pill hardcodes system blue; it does not follow AccentFillColor. -->
                    <SolidColorBrush x:Key="TreeViewItemSelectionIndicatorForeground" Color="#FF8C2332" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <!-- Tints have to sit heavier on a dark pane to register at all. -->
                    <SolidColorBrush x:Key="TreeViewItemBackgroundSelected" Color="#66A82C3E" />
                    <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPointerOver" Color="#80A82C3E" />
                    <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPressed" Color="#99A82C3E" />
                    <SolidColorBrush x:Key="TreeViewItemBackgroundPointerOver" Color="#2EA82C3E" />
                    <SolidColorBrush x:Key="TreeViewItemBackgroundPressed" Color="#40A82C3E" />
                    <SolidColorBrush x:Key="TreeViewItemSelectionIndicatorForeground" Color="#FFA82C3E" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- AllowDrop on the whole pane so files dropped from Explorer land here, not only on a row -->
    <Grid AllowDrop="True"
          DragOver="OnDragOver"
          DragLeave="OnDragLeave"
          Drop="OnDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Current root, upload, and a manual refresh -->
        <Grid Grid.Row="0" Margin="4,2,2,6" ColumnSpacing="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="PathText"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap"
                       Text="" />

            <Button x:Name="UploadButton"
                    Grid.Column="1"
                    Width="28"
                    Height="26"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    IsEnabled="False"
                    ToolTipService.ToolTip="Upload files to the selected folder, or to this folder"
                    Click="OnUploadClick">
                <FontIcon Glyph="&#xE898;" FontSize="13" />
            </Button>

            <Button x:Name="UpButton"
                    Grid.Column="2"
                    Width="28"
                    Height="26"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    IsEnabled="False"
                    ToolTipService.ToolTip="Parent folder"
                    Click="OnUpClick">
                <FontIcon Glyph="&#xE70E;" FontSize="13" />
            </Button>

            <Button x:Name="HomeButton"
                    Grid.Column="3"
                    Width="28"
                    Height="26"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    IsEnabled="False"
                    ToolTipService.ToolTip="Login folder"
                    Click="OnHomeClick">
                <FontIcon Glyph="&#xE80F;" FontSize="13" />
            </Button>

            <Button x:Name="RefreshButton"
                    Grid.Column="4"
                    Width="28"
                    Height="26"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    IsEnabled="False"
                    ToolTipService.ToolTip="Refresh"
                    Click="OnRefreshClick">
                <FontIcon Glyph="&#xE72C;" FontSize="13" />
            </Button>
        </Grid>

        <TreeView x:Name="Tree"
                  Grid.Row="1"
                  SelectionMode="Single"
                  CanDragItems="False"
                  CanReorderItems="False"
                  Expanding="OnExpanding"
                  ItemInvoked="OnItemInvoked">
            <!--
                Node mode (RootNodes) hands the template a TreeViewNode, not the model, so the
                data type is TreeViewNode and each binding reaches the entry through Content.
                Declaring the model here instead makes the generated x:Bind cast blow up as soon
                as the first item is realised.
            -->
            <TreeView.ItemTemplate>
                <DataTemplate x:DataType="TreeViewNode">
                    <TreeViewItem AutomationProperties.Name="{x:Bind ((models:RemoteEntry)Content).Name}"
                                  ToolTipService.ToolTip="{x:Bind ((models:RemoteEntry)Content).Tooltip}"
                                  RightTapped="OnItemRightTapped">
                        <!--
                            RightTapped selects the row before this opens, so every command reads the
                            selection instead of depending on a template's DataContext reaching into
                            a flyout's separate visual tree. It also hides the items that do not
                            apply, keyed by Tag — x:Name is not reachable from inside a template.
                        -->
                        <TreeViewItem.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Go to this folder" Tag="folder" Click="OnGoToFolderClick">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE72A;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Download…" Tag="file" Click="OnDownloadClick">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE896;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Download this folder…" Tag="folder" Click="OnDownloadFolderClick">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8DE;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Upload files here…" Tag="folder" Click="OnUploadHereClick">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE898;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Upload a folder here…" Tag="folder" Click="OnUploadFolderHereClick">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8F4;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator Tag="both" />
                                <MenuFlyoutItem Text="Copy path" Tag="both" Click="OnCopyPathClick">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8C8;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </TreeViewItem.ContextFlyout>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0"
                                      Glyph="{x:Bind ((models:RemoteEntry)Content).Glyph}"
                                      FontSize="13"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <!-- Name only. Size and date are in the tooltip; the pane is narrow. -->
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ((models:RemoteEntry)Content).Name}"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </TreeViewItem>
                </DataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <!-- Tint over the tree while a drag from Explorer hovers the pane -->
        <Border x:Name="DropHint"
                Grid.Row="1"
                CornerRadius="6"
                BorderThickness="1"
                IsHitTestVisible="False"
                Visibility="Collapsed" />

        <!-- Covers the tree while connecting, when idle, or after a failure -->
        <StackPanel x:Name="Status"
                    Grid.Row="1"
                    Margin="12"
                    Spacing="10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <ProgressRing x:Name="BusyRing"
                          Width="24"
                          Height="24"
                          IsActive="False"
                          HorizontalAlignment="Center" />
            <TextBlock x:Name="StatusText"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="No open sessions" />
            <Button x:Name="StatusRetryButton"
                    Content="Retry"
                    HorizontalAlignment="Center"
                    Visibility="Collapsed"
                    Click="OnRefreshClick" />
        </StackPanel>

        <!-- Upload progress; only visible while a transfer is running or just finished -->
        <Grid x:Name="Transfer"
              Grid.Row="2"
              Margin="4,6,2,2"
              ColumnSpacing="4"
              Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                <TextBlock x:Name="TransferText"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap"
                           Text="" />
                <ProgressBar x:Name="TransferBar"
                             Height="3"
                             Minimum="0"
                             Maximum="1" />
            </StackPanel>

            <Button x:Name="TransferCancelButton"
                    Grid.Column="1"
                    Width="24"
                    Height="24"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTipService.ToolTip="Cancel upload"
                    Click="OnCancelTransferClick">
                <FontIcon Glyph="&#xE711;" FontSize="12" />
            </Button>
        </Grid>
    </Grid>
</UserControl>
