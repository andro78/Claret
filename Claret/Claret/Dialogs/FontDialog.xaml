<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Claret.Dialogs.FontDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Terminal font"
    PrimaryButtonText="Apply"
    SecondaryButtonText="Defaults"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <StackPanel Spacing="12" Width="440">

        <!--
            Only a face that advances one Hangul syllable across two Latin cells keeps CJK columns
            aligned, so each entry says whether it manages that, and whether it is even installed.
        -->
        <ComboBox x:Name="FamilyBox"
                  Header="Font"
                  HorizontalAlignment="Stretch"
                  SelectionChanged="OnFamilyChanged" />

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <NumberBox x:Name="SizeBox"
                       Grid.Column="0"
                       Width="120"
                       Header="Size"
                       Minimum="8"
                       Maximum="28"
                       SmallChange="1"
                       LargeChange="2"
                       SpinButtonPlacementMode="Inline"
                       ValueChanged="OnSizeChanged" />

            <Slider x:Name="SizeSlider"
                    Grid.Column="1"
                    Header="&#160;"
                    Minimum="8"
                    Maximum="28"
                    StepFrequency="1"
                    TickFrequency="2"
                    TickPlacement="None"
                    ValueChanged="OnSliderChanged" />
        </Grid>

        <TextBlock Text="Preview" Style="{StaticResource CaptionTextBlockStyle}" />
        <Border x:Name="PreviewBorder"
                CornerRadius="6"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Padding="12">
            <StackPanel Spacing="4">
                <TextBlock x:Name="PromptLine" Text="root@server:~/var/log# tail -f messages" />
                <!--
                    Five Hangul syllables over ten digits: the trailing bars line up only when the
                    font gives each syllable exactly two cells.
                -->
                <TextBlock x:Name="HangulLine" Text="가나다라마|" />
                <TextBlock x:Name="RulerLine" Text="1234567890|" />
                <TextBlock x:Name="MixedLine" Text="디렉터리 목록 mixed abc 123" />
            </StackPanel>
        </Border>

        <TextBlock x:Name="Note"
                   TextWrapping="Wrap"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="" />
    </StackPanel>
</ContentDialog>
