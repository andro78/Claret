<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="PowerTerm.Dialogs.ShortcutsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Keyboard shortcuts"
    CloseButtonText="Close"
    DefaultButton="Close">

    <!--
        Built in markup rather than from the accelerator table: the terminal holds keyboard focus and
        forwards its own chords, so the real list lives in two places and neither is enumerable. A
        written list can at least be read against both.
    -->
    <ScrollViewer MaxHeight="460" Width="420">
        <StackPanel Spacing="18">

            <StackPanel Spacing="4">
                <TextBlock Text="Sessions" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Grid ColumnSpacing="16" RowSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Ctrl+Shift+T" FontFamily="Consolas" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="New session" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Ctrl+Shift+W" FontFamily="Consolas" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Close this session" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Ctrl+Tab" FontFamily="Consolas" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Next session" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Ctrl+Shift+Tab" FontFamily="Consolas" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="Previous session" TextWrapping="Wrap" />
                </Grid>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Layout" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Grid ColumnSpacing="16" RowSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Alt+Shift++" FontFamily="Consolas" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Split right" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Alt+Shift+-" FontFamily="Consolas" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Split down" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Ctrl+Shift+B" FontFamily="Consolas" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Show or hide the panel" TextWrapping="Wrap" />
                </Grid>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Clipboard" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Grid ColumnSpacing="16" RowSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Ctrl+Shift+C" FontFamily="Consolas" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Copy the selection" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Ctrl+V" FontFamily="Consolas" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Paste — as does Ctrl+Shift+V, and the middle button" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Ctrl+C" FontFamily="Consolas" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Interrupt (SIGINT). With &quot;Copy on selection&quot; off and text selected, it copies instead." TextWrapping="Wrap" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Select with the mouse" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="Copies straight away, unless that option is off" TextWrapping="Wrap" />
                </Grid>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Text size" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Grid ColumnSpacing="16" RowSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Ctrl++  /  Ctrl+-" FontFamily="Consolas" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Larger or smaller" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Ctrl+0" FontFamily="Consolas" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Back to 14" TextWrapping="Wrap" />
                </Grid>
            </StackPanel>

            <TextBlock TextWrapping="Wrap"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="These work while the terminal has focus as well as anywhere else in the window." />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
