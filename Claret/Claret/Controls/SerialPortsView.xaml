<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Claret.Controls.SerialPortsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Claret.Models"
    xmlns:local="using:Claret.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            Pinned boards first: the console you open every day should not need the port list, and
            it survives the COM number changing because the profile carries the settings with it.
        -->
        <TextBlock x:Name="PinnedHeader"
                   Grid.Row="0"
                   Margin="4,2,2,2"
                   Visibility="Collapsed"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="Pinned" />

        <ListView x:Name="PinnedList"
                  Grid.Row="1"
                  MaxHeight="160"
                  Visibility="Collapsed"
                  SelectionMode="Single"
                  DoubleTapped="OnPinnedDoubleTapped">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:SerialProfile">
                    <Border Padding="6,8"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind DisplayName}"
                                       FontWeight="SemiBold"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Detail}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Open" Click="OnOpenPinnedClick" />
                    <MenuFlyoutItem Text="Rename…" Click="OnRenamePinnedClick" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Unpin" Click="OnUnpinClick" />
                </MenuFlyout>
            </ListView.ContextFlyout>
        </ListView>

        <Grid Grid.Row="2" Margin="4,8,2,6" ColumnSpacing="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="Serial ports" />

            <Button x:Name="PinButton"
                    Grid.Column="1"
                    Width="28"
                    Height="26"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    IsEnabled="False"
                    ToolTipService.ToolTip="Pin this port and its settings"
                    Click="OnPinClick">
                <FontIcon Glyph="&#xE718;" FontSize="13" />
            </Button>

            <Button x:Name="RefreshButton"
                    Grid.Column="2"
                    Width="28"
                    Height="26"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTipService.ToolTip="Rescan"
                    Click="OnRefreshClick">
                <FontIcon Glyph="&#xE72C;" FontSize="13" />
            </Button>
        </Grid>

        <ListView x:Name="PortList"
                  Grid.Row="3"
                  SelectionMode="Single"
                  SelectionChanged="OnSelectionChanged"
                  DoubleTapped="OnListDoubleTapped">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:SerialPortItem">
                    <Border Padding="6,8"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind PortName}"
                                       FontWeight="SemiBold"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Detail}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock x:Name="EmptyState"
                   Grid.Row="3"
                   Margin="12"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="No serial ports found. Plug in an adapter and rescan." />

        <!-- 115200 8N1 covers almost every board console; the rest is here for the ones it does not. -->
        <Grid Grid.Row="4" Margin="4,6,2,0" RowSpacing="6" ColumnSpacing="6">
            <!--
                Not an even split: the left column holds "8N1" and the right holds "XON/XOFF" and
                the longer header. Equal halves would clip the right one first as the panel narrows.
            -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Baud gets the full width: it is the one that changes, and the longest value. -->
            <ComboBox x:Name="BaudBox"
                      Grid.Row="0"
                      Grid.ColumnSpan="2"
                      Header="Baud rate"
                      HorizontalAlignment="Stretch"
                      SelectionChanged="OnSettingChanged" />

            <!--
                The other two share a row. Their headers are short so the pair still fits when the
                panel is dragged narrow; the full phrase is on the tooltip, where a long label
                belongs when the column is 90 pixels wide.
            -->
            <ComboBox x:Name="FormatBox"
                      Grid.Row="1"
                      Grid.Column="0"
                      Header="Data bits"
                      HorizontalAlignment="Stretch"
                      ToolTipService.ToolTip="Data bits, parity, stop"
                      SelectionChanged="OnSettingChanged" />

            <ComboBox x:Name="FlowBox"
                      Grid.Row="1"
                      Grid.Column="1"
                      Header="Flow control"
                      HorizontalAlignment="Stretch"
                      ToolTipService.ToolTip="Flow control"
                      SelectionChanged="OnSettingChanged" />
        </Grid>

        <!--
            One button for the port, not two: while the selected port is open it closes it instead.
            Opening and closing the same line are one decision seen from either side, and a dead
            "Open" sitting next to a live console is a state you have to read twice.
        -->
        <Button x:Name="OpenButton"
                Grid.Row="5"
                Margin="4,8,2,2"
                HorizontalAlignment="Stretch"
                IsEnabled="False"
                Style="{StaticResource AccentButtonStyle}"
                Click="OnOpenClick">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon x:Name="OpenIcon" Glyph="&#xE839;" FontSize="13" />
                <TextBlock x:Name="OpenLabel" Text="Open port" />
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
