<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Claret.Controls.TerminalView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.Background>
            <SolidColorBrush x:Name="TerminalBackground" Color="#0C0C0C" />
        </Grid.Background>
        <WebView2 x:Name="Web" />

        <!-- Covers the terminal while connecting and after the session ends. -->
        <Grid x:Name="Overlay"
              Background="#E0101010"
              Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="14"
                        MaxWidth="520">
                <ProgressRing x:Name="BusyRing"
                              Width="34"
                              Height="34"
                              IsActive="False"
                              HorizontalAlignment="Center" />
                <FontIcon x:Name="OverlayIcon"
                          Glyph="&#xEA39;"
                          FontSize="30"
                          Foreground="#E88"
                          Visibility="Collapsed"
                          HorizontalAlignment="Center" />
                <TextBlock x:Name="OverlayTitle"
                           Text=""
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#F0F0F0"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="OverlayDetail"
                           Text=""
                           FontSize="12.5"
                           Foreground="#B0B0B0"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           IsTextSelectionEnabled="True" />
                <StackPanel x:Name="OverlayButtons"
                            Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Center">
                    <Button x:Name="RetryButton"
                            Content="Reconnect now"
                            Visibility="Collapsed"
                            Click="OnRetryClick" />
                    <Button x:Name="StopRetryButton"
                            Content="Stop auto-reconnect"
                            Visibility="Collapsed"
                            Click="OnStopRetryClick" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
