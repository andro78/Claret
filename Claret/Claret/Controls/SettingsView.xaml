<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Claret.Controls.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,14,0,2" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <!--
        Every app-wide preference in one place. Changes apply as they are made — there is no Save —
        the same as the Serial panel's line settings, so nothing here can be half-applied.
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="10,2,10,12" Spacing="8">

            <TextBlock Style="{StaticResource SectionHeader}" Margin="0,6,0,2" Text="Terminal" />

            <ToggleSwitch x:Name="CopyOnSelectSwitch"
                          Header="Copy on selection"
                          OnContent="On"
                          OffContent="Off"
                          Toggled="OnCopyOnSelectToggled" />

            <NumberBox x:Name="ScrollbackBox"
                       Header="Scrollback lines"
                       Minimum="100"
                       Maximum="9999"
                       SmallChange="100"
                       LargeChange="1000"
                       SpinButtonPlacementMode="Compact"
                       ValueChanged="OnScrollbackChanged" />

            <!--
                Defaults for tabs opened from now on. Changing one open tab is on that tab's
                right-click menu, and never touches these.
            -->
            <Grid ColumnSpacing="8" RowSpacing="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.ColumnSpan="2" Text="Font for new tabs" />
                <Button Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Content="Change…" Click="OnFontClick" />
                <TextBlock x:Name="FontText"
                           Grid.Row="1"
                           VerticalAlignment="Center"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>

            <Grid ColumnSpacing="8" RowSpacing="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.ColumnSpan="2" Text="Colors for new tabs" />
                <Button Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Content="Change…" Click="OnColorsClick" />
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Border x:Name="ColorSwatch"
                            Width="22"
                            Height="16"
                            CornerRadius="3"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="ColorSwatchText"
                                   Text="A"
                                   FontSize="10"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="ColorText"
                               VerticalAlignment="Center"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <TextBlock Style="{StaticResource Hint}"
                       Text="To change one open tab only, right-click its tab and choose Font… or Colors…" />

            <TextBlock Style="{StaticResource SectionHeader}" Text="Serial" />

            <ToggleSwitch x:Name="SerialTimestampsSwitch"
                          Header="Timestamp each line of serial output"
                          OnContent="On"
                          OffContent="Off"
                          Toggled="OnSerialTimestampsToggled" />

            <TextBlock Style="{StaticResource SectionHeader}" Text="Downloads" />

            <StackPanel Spacing="4">
                <TextBlock Text="Save downloads to" />
                <TextBlock x:Name="DownloadFolderText"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                    <Button Content="Choose folder…" Click="OnChooseFolderClick" />
                    <Button x:Name="AskEachTimeButton" Content="Ask each time" Click="OnAskEachTimeClick" />
                </StackPanel>
            </StackPanel>

            <TextBlock Style="{StaticResource SectionHeader}" Text="Updates" />

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="VersionText"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button Grid.Column="1" Content="Check now" Click="OnCheckUpdatesClick" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
