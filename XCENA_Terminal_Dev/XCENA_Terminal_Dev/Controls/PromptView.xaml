<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="XCENA_Terminal_Dev.Controls.PromptView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:XCENA_Terminal_Dev.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Margin="4,2,2,6"
                   VerticalAlignment="Center"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="Prompt" />

        <!--
            Writing a long prompt at a shell prompt is miserable: no wrapping to speak of, no way
            back up a line, and Enter submits. This is a plain editor that hands the finished text
            to the session as a paste, so newlines survive and the CLI sees one input.
        -->
        <TextBox x:Name="Editor"
                 Grid.Row="1"
                 MinHeight="120"
                 MaxHeight="260"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 PlaceholderText="Ask the AI CLI running in this session…"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 TextChanged="OnTextChanged"
                 PreviewKeyDown="OnEditorKeyDown" />

        <TextBlock x:Name="Target"
                   Grid.Row="2"
                   Margin="4,6,2,0"
                   TextWrapping="Wrap"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                   Text="No session" />

        <Grid Grid.Row="3" Margin="4,8,2,2" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="SendButton"
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    IsEnabled="False"
                    Style="{StaticResource AccentButtonStyle}"
                    ToolTipService.ToolTip="Ctrl+Enter"
                    Click="OnSendClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE724;" FontSize="13" />
                    <TextBlock Text="Send" />
                </StackPanel>
            </Button>

            <!-- Paste without the newline, for when the CLI wants the text edited in place first. -->
            <Button x:Name="InsertButton"
                    Grid.Column="1"
                    IsEnabled="False"
                    ToolTipService.ToolTip="Paste into the session without sending"
                    Click="OnInsertClick">
                <FontIcon Glyph="&#xE77F;" FontSize="13" />
            </Button>
        </Grid>

        <!-- What was sent before, newest first: prompts get reused and tweaked more than written. -->
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="HistoryHeader"
                       Grid.Row="0"
                       Margin="4,0,2,2"
                       Visibility="Collapsed"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="Recent" />

            <ListView x:Name="HistoryList"
                      Grid.Row="1"
                      SelectionMode="Single"
                      DoubleTapped="OnHistoryDoubleTapped">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{x:Bind}"
                                   Padding="4,6"
                                   MaxLines="2"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Use" Click="OnUseHistoryClick" />
                        <MenuFlyoutItem Text="Send again" Click="OnSendHistoryClick" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Remove" Click="OnRemoveHistoryClick" />
                    </MenuFlyout>
                </ListView.ContextFlyout>
            </ListView>
        </Grid>
    </Grid>
</UserControl>
