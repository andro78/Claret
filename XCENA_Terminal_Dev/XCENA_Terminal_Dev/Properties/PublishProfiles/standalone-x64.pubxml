<?xml version="1.0" encoding="utf-8"?>
<!--
  Standalone distribution: an unpackaged folder the recipient can run straight from
  Explorer. SelfContained bundles the .NET runtime and WindowsAppSDKSelfContained
  bundles the Windows App SDK runtime, so nothing has to be installed first.

  Kept separate from win-x64.pubxml on purpose — the MSIX packaging project
  references that one by its win-$(Platform) name.

  Publish with:
    dotnet publish XCENA_Terminal_Dev\XCENA_Terminal_Dev\XCENA_Terminal_Dev.csproj `
      -c Release -p:Platform=x64 -p:PublishProfile=standalone-x64
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishDir>bin\Publish\standalone-x64\</PublishDir>

    <WindowsPackageType>None</WindowsPackageType>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

    <PublishSingleFile>false</PublishSingleFile>
    <!-- SSH.NET resolves crypto algorithms reflectively; trimming strips them. -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>
</Project>
