<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="XCENA_Terminal_Dev.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:XCENA_Terminal_Dev"
    xmlns:models="using:XCENA_Terminal_Dev.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="XCENA Terminal">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Drag region for the extended title bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40" Padding="12,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="ToggleSidebarButton"
                    Grid.Column="0"
                    Width="34"
                    Height="30"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTipService.ToolTip="Profiles (Ctrl+Shift+B)"
                    Click="OnToggleSidebarClick">
                <FontIcon Glyph="&#xE700;" FontSize="14" />
            </Button>

            <DropDownButton x:Name="LayoutButton"
                            Grid.Column="1"
                            Height="30"
                            Padding="8,0"
                            Margin="4,0,0,0"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTipService.ToolTip="Layout">
                <TextBlock x:Name="LayoutLabel"
                           Text="Single pane (merge all)"
                           VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}" />
                <DropDownButton.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <RadioMenuFlyoutItem x:Name="LayoutSingleItem"
                                             Text="Single pane (merge all)"
                                             GroupName="surfaceLayout"
                                             IsChecked="True"
                                             Click="OnLayoutSingleClick" />
                        <RadioMenuFlyoutItem x:Name="LayoutSideItem"
                                             Text="Spread all sessions left to right"
                                             GroupName="surfaceLayout"
                                             KeyboardAcceleratorTextOverride="Alt+Shift++"
                                             Click="OnLayoutSideClick" />
                        <RadioMenuFlyoutItem x:Name="LayoutStackItem"
                                             Text="Spread all sessions top to bottom"
                                             GroupName="surfaceLayout"
                                             KeyboardAcceleratorTextOverride="Alt+Shift+-"
                                             Click="OnLayoutStackClick" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>

            <Button x:Name="AppearanceButton"
                    Grid.Column="2"
                    Width="34"
                    Height="30"
                    Padding="0"
                    Margin="2,0,0,0"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTipService.ToolTip="Terminal colors"
                    Click="OnAppearanceClick">
                <FontIcon Glyph="&#xE790;" FontSize="14" />
            </Button>

            <TextBlock x:Name="AppTitleText"
                       Grid.Column="3"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Text="XCENA Terminal" />
        </Grid>

        <Grid x:Name="BodyGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="256" />
                <ColumnDefinition x:Name="SplitterColumn" Width="6" />
                <ColumnDefinition x:Name="RightColumn" Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Saved profiles -->
            <Grid x:Name="Sidebar" Grid.Column="0" Margin="8,0,4,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Drag handle: press here and drag to dock the sidebar on the other side. -->
                <Border x:Name="SidebarHeader"
                        Grid.Row="0"
                        Margin="0,0,0,6"
                        Padding="8,4"
                        CornerRadius="6"
                        Background="Transparent">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE700;"
                                  FontSize="12"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}"
                                   Text="Saved connections" />
                    </StackPanel>
                    <Border.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Dock left" Click="OnDockLeftClick" />
                            <MenuFlyoutItem Text="Dock right" Click="OnDockRightClick" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Hide panel"
                                            KeyboardAcceleratorTextOverride="Ctrl+Shift+B"
                                            Click="OnToggleSidebarClick" />
                        </MenuFlyout>
                    </Border.ContextFlyout>
                </Border>

                <Border Grid.Row="1"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <ListView x:Name="ProfileList"
                                  Margin="2"
                                  SelectionMode="Single"
                                  DoubleTapped="OnProfileDoubleTapped"
                                  ItemsSource="{x:Bind Profiles}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:ConnectionProfile">
                                    <StackPanel Padding="4,6" Spacing="1">
                                        <TextBlock Text="{x:Bind DisplayName}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Endpoint}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                            <ListView.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Connect" Click="OnConnectProfileClick">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8AF;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Edit" Click="OnEditProfileClick">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE70F;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Forget host key" Click="OnForgetHostKeyClick" />
                                    <MenuFlyoutItem Text="Delete" Click="OnDeleteProfileClick">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE74D;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </ListView.ContextFlyout>
                        </ListView>

                        <TextBlock x:Name="NoProfilesText"
                                   Margin="16"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="No saved connections.&#x0a;Tick 'Save to profile list' when you connect." />
                    </Grid>
                </Border>

                <Button Grid.Row="2"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="Ctrl+Shift+T"
                        Click="OnNewConnectionClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="New connection" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Sessions: the tab strip only selects; every terminal lives in SurfaceHost. -->
            <Grid x:Name="SessionArea" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Every tab strip lives inside its own pane, so there is no global strip. -->
                <Grid x:Name="SurfaceHost" Grid.Row="0" />

                <StackPanel x:Name="EmptyState"
                            Grid.Row="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="16"
                            MaxWidth="420">
                    <FontIcon Glyph="&#xE756;"
                              FontSize="42"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock HorizontalAlignment="Center"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               Text="No open sessions" />
                    <TextBlock HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Start a new connection, or double-click a saved profile on the left." />
                    <Button HorizontalAlignment="Center"
                            Style="{StaticResource AccentButtonStyle}"
                            Content="New connection (Ctrl+Shift+T)"
                            Click="OnNewConnectionClick" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
