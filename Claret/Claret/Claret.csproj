<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <RootNamespace>Claret</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Build stamp for the About dialog. Baked into the assembly rather than read from the file's
    timestamp at run time: the attribute travels with the binary, so publishing, zipping or moving
    the folder cannot change the answer.

    Written as round-trip UTC and shown in local time, so a build passed to someone in another
    zone still reads correctly. The cost is that the generated assembly info differs on every
    evaluation, so each build recompiles even when no source changed — cheap here, and a stamp
    that can be stale is not worth having.
  -->
  <ItemGroup>
    <AssemblyMetadata Include="BuildTime" Value="$([System.DateTime]::UtcNow.ToString('O'))" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <!-- Serial consoles: the port itself, and WMI only to name it something friendlier than COM7. -->
    <PackageReference Include="System.IO.Ports" Version="10.0.11" />
    <PackageReference Include="System.Management" Version="10.0.11" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
  </ItemGroup>

  <!-- App icon: embedded in the exe by ApplicationIcon, copied out for AppWindow.SetIcon -->
  <ItemGroup>
    <Content Include="Assets\AppIcon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- xterm.js bundle served to WebView2 through a virtual host mapping -->
  <ItemGroup>
    <Content Include="Assets\xterm\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    The manual travels with the app, so Help → Manual works on a machine with no network and no
    access to the repository. Link, not copy: the file in docs\ stays the only one edited.
  -->
  <ItemGroup>
    <Content Include="..\..\docs\MANUAL.md" Link="docs\MANUAL.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    An unpackaged publish drops the compiled XAML (*.xbf) and the app resource index (*.pri)
    even though the build produces them, and without those Application.Start fails at startup
    with E_FAIL inside Microsoft.UI.Xaml.dll. Add them back to the publish item list.
  -->
  <Target Name="IncludeXamlArtifactsInPublish" BeforeTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_XamlPublishArtifact Include="$(OutDir)*.xbf" />
      <_XamlPublishArtifact Include="$(OutDir)$(AssemblyName).pri" />
      <ResolvedFileToPublish Include="@(_XamlPublishArtifact)">
        <RelativePath>%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

    <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <!-- SSH.NET resolves crypto algorithms reflectively; trimming strips them. -->
    <PublishTrimmed>False</PublishTrimmed>
  </PropertyGroup>
</Project>