<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="XCENA_Terminal_Dev.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:XCENA_Terminal_Dev"
    xmlns:models="using:XCENA_Terminal_Dev.Models"
    xmlns:local2="using:XCENA_Terminal_Dev.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="XCENA Terminal">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Drag region for the extended title bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40" Padding="12,0,144,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--
                The app icon, first thing on the left. Not a button: it stays part of the drag
                region, which is what the far left of a title bar is for.
            -->
            <Image x:Name="AppIcon"
                   Grid.Column="0"
                   Width="18"
                   Height="18"
                   Margin="0,0,8,0"
                   VerticalAlignment="Center"
                   Source="ms-appx:///Assets/AppIcon.ico" />

            <Button x:Name="AppearanceButton"
                    Grid.Column="1"
                    Width="34"
                    Height="30"
                    Padding="0"
                    Margin="2,0,0,0"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTipService.ToolTip="Terminal colors"
                    Click="OnAppearanceClick">
                <FontIcon Glyph="&#xE790;" FontSize="14" />
            </Button>

            <DropDownButton x:Name="OptionsButton"
                            Grid.Column="2"
                            Height="30"
                            Padding="8,0"
                            Margin="2,0,0,0"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTipService.ToolTip="Options">
                <TextBlock Text="Options"
                           VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}" />
                <DropDownButton.Flyout>
                    <!-- Opening syncs the check mark and greys out what the tree cannot do yet. -->
                    <MenuFlyout Placement="Bottom" Opening="OnOptionsOpening">
                        <!-- Mouse selection straight to the clipboard; paste is middle-click or Ctrl+V. -->
                        <ToggleMenuFlyoutItem x:Name="CopyOnSelectItem"
                                              Text="Copy on selection"
                                              Click="OnCopyOnSelectClick" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutSubItem x:Name="SftpMenu" Text="SFTP">
                            <MenuFlyoutSubItem.Icon>
                                <FontIcon Glyph="&#xE8B7;" />
                            </MenuFlyoutSubItem.Icon>
                            <ToggleMenuFlyoutItem x:Name="SftpShowFilesItem"
                                                  Text="Show files in the tree"
                                                  Click="OnSftpShowFilesClick" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="SftpUploadItem"
                                            Text="Upload files…"
                                            Click="OnSftpUploadClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE898;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="SftpDownloadItem"
                                            Text="Download selected file…"
                                            Click="OnSftpDownloadClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE896;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <!-- Text is rewritten on Opening to show the folder currently in use. -->
                            <MenuFlyoutItem x:Name="SftpDownloadFolderItem"
                                            Text="Download folder…"
                                            Click="OnSftpDownloadFolderClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8DA;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="SftpAskEachTimeItem"
                                            Text="Ask where to save each file"
                                            Click="OnSftpAskEachTimeClick" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="SftpRefreshItem"
                                            Text="Refresh folder tree"
                                            Click="OnSftpRefreshClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE72C;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyoutSubItem>
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>

            <!--
                What the active session calls itself, centred on the window rather than on the gap
                between the buttons — so it spans every column and never takes a click. The app
                name is not repeated here; the taskbar already carries it.
            -->
            <TextBlock x:Name="AppTitleText"
                       Grid.Column="0"
                       Grid.ColumnSpan="5"
                       MaxWidth="420"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Text="" />

            <!-- Layout sits at the far right, next to the caption buttons: the padding on
                 AppTitleBar is widened at run time so it never sits under them. -->
            <DropDownButton x:Name="LayoutButton"
                            Grid.Column="4"
                            Height="30"
                            Padding="8,0"
                            Margin="8,0,0,0"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTipService.ToolTip="Layout">
                <TextBlock x:Name="LayoutLabel"
                           Text="Single pane (merge all)"
                           VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}" />
                <DropDownButton.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <RadioMenuFlyoutItem x:Name="LayoutSingleItem"
                                             Text="Single pane (merge all)"
                                             GroupName="surfaceLayout"
                                             IsChecked="True"
                                             Click="OnLayoutSingleClick" />
                        <RadioMenuFlyoutItem x:Name="LayoutSideItem"
                                             Text="Spread all sessions left to right"
                                             GroupName="surfaceLayout"
                                             KeyboardAcceleratorTextOverride="Alt+Shift++"
                                             Click="OnLayoutSideClick" />
                        <RadioMenuFlyoutItem x:Name="LayoutStackItem"
                                             Text="Spread all sessions top to bottom"
                                             GroupName="surfaceLayout"
                                             KeyboardAcceleratorTextOverride="Alt+Shift+-"
                                             Click="OnLayoutStackClick" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </Grid>

        <Grid x:Name="BodyGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="256" />
                <ColumnDefinition x:Name="SplitterColumn" Width="6" />
                <ColumnDefinition x:Name="RightColumn" Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Panel: a vertical tab rail on the inner edge, with the selected card beside it -->
            <Grid x:Name="Sidebar" Grid.Column="0" Margin="8,6,4,8">
                <!--
                    Which of these two columns holds the rail depends on the dock side, so the
                    icons always sit on the window edge; the widths are swapped in code with them.
                -->
                <Grid ColumnSpacing="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="SidebarInnerLeft" Width="Auto" />
                        <ColumnDefinition x:Name="SidebarInnerRight" Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--
                        Stays put when the panel is collapsed: the icons are how it comes back, and
                        the strip is also the drag handle for docking, so it spans the full height
                        and paints a transparent background to stay hit-testable.
                    -->
                    <Border x:Name="SidebarRail"
                            Grid.Column="0"
                            Background="Transparent"
                            ToolTipService.ToolTip="Click an icon to show or hide the panel · drag left or right to dock">
                    <StackPanel Spacing="4" VerticalAlignment="Top">
                        <Button x:Name="SessionsTabButton"
                                Width="34"
                                Height="36"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTipService.ToolTip="Sessions"
                                Click="OnSessionsTabClick">
                            <Grid Width="34" Height="36">
                                <Border x:Name="SessionsTabMarker"
                                        Width="3"
                                        Height="18"
                                        CornerRadius="2"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center" />
                                <FontIcon x:Name="SessionsTabIcon" Glyph="&#xE774;" FontSize="16" />
                            </Grid>
                        </Button>

                        <Button x:Name="FilesTabButton"
                                Width="34"
                                Height="36"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTipService.ToolTip="Files"
                                Click="OnFilesTabClick">
                            <Grid Width="34" Height="36">
                                <Border x:Name="FilesTabMarker"
                                        Width="3"
                                        Height="18"
                                        CornerRadius="2"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center" />
                                <FontIcon x:Name="FilesTabIcon" Glyph="&#xE8B7;" FontSize="16" />
                            </Grid>
                        </Button>

                        <Button x:Name="ToolsTabButton"
                                Width="34"
                                Height="36"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTipService.ToolTip="Tools"
                                Click="OnToolsTabClick">
                            <Grid Width="34" Height="36">
                                <Border x:Name="ToolsTabMarker"
                                        Width="3"
                                        Height="18"
                                        CornerRadius="2"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center" />
                                <FontIcon x:Name="ToolsTabIcon" Glyph="&#xE90F;" FontSize="16" />
                            </Grid>
                        </Button>
                    </StackPanel>
                    </Border>

                    <!-- The part that hides on collapse; the rail beside it stays. -->
                    <Grid x:Name="SidebarCards" Grid.Column="1">

                <!--
                    Translation on Z is what gives a ThemeShadow its depth; the value is the
                    elevation, and the shadow follows the rounded corners on its own.
                -->
                <Border x:Name="ProfileCard"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Translation="0,0,28">
                    <Border.Shadow>
                        <ThemeShadow />
                    </Border.Shadow>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ListView x:Name="ProfileList"
                                  Grid.Row="0"
                                  Margin="2"
                                  SelectionMode="Single"
                                  DoubleTapped="OnProfileDoubleTapped"
                                  ItemsSource="{x:Bind Profiles}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:ConnectionProfile">
                                    <StackPanel Padding="4,6" Spacing="1">
                                        <TextBlock Text="{x:Bind DisplayName}"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Endpoint}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                            <ListView.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Connect" Click="OnConnectProfileClick">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8AF;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Edit" Click="OnEditProfileClick">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE70F;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Forget host key" Click="OnForgetHostKeyClick" />
                                    <MenuFlyoutItem Text="Delete" Click="OnDeleteProfileClick">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE74D;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </ListView.ContextFlyout>
                        </ListView>

                        <TextBlock x:Name="NoProfilesText"
                                   Grid.Row="0"
                                   Margin="16"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="No saved connections.&#x0a;Tick 'Save to profile list' when you connect." />
                        <!-- Inside the card: the action belongs to the list it acts on -->
                        <Border Grid.Row="1"
                                Padding="6"
                                BorderThickness="0,1,0,0"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <Button x:Name="NewConnectionButton"
                                    HorizontalAlignment="Stretch"
                                    Style="{StaticResource AccentButtonStyle}"
                                    ToolTipService.ToolTip="Ctrl+Shift+T"
                                    Click="OnNewConnectionClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                                    <TextBlock Text="New connection" />
                                </StackPanel>
                            </Button>
                        </Border>
                    </Grid>
                </Border>

                <Border x:Name="FilesCard"
                        Padding="2"
                        Visibility="Collapsed"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Translation="0,0,28">
                    <Border.Shadow>
                        <ThemeShadow />
                    </Border.Shadow>
                    <local2:RemoteFilesView x:Name="Files" />
                </Border>

                <Border x:Name="ToolsCard"
                        Padding="2"
                        Visibility="Collapsed"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Translation="0,0,28">
                    <Border.Shadow>
                        <ThemeShadow />
                    </Border.Shadow>
                    <local2:HighlightRulesView x:Name="Tools" />
                </Border>

                    </Grid>
                </Grid>


            </Grid>

            <!-- Sessions: the tab strip only selects; every terminal lives in SurfaceHost. -->
            <Grid x:Name="SessionArea" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Every tab strip lives inside its own pane, so there is no global strip. -->
                <Grid x:Name="SurfaceHost" Grid.Row="0" />

                <StackPanel x:Name="EmptyState"
                            Grid.Row="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="16"
                            MaxWidth="420">
                    <FontIcon Glyph="&#xE756;"
                              FontSize="42"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock HorizontalAlignment="Center"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               Text="No open sessions" />
                    <TextBlock HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Start a new connection, or double-click a saved profile on the left." />
                    <Button HorizontalAlignment="Center"
                            Style="{StaticResource AccentButtonStyle}"
                            Content="New connection (Ctrl+Shift+T)"
                            Click="OnNewConnectionClick" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Status bar: what is connected on the left, what the keyboard will type on the right. -->
        <Border Grid.Row="2"
                Height="26"
                Padding="12,0"
                BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--
                    Installs an AI CLI on the host you are connected to. Items are built on
                    Opening, because what they can do depends on the live session.
                -->
                <DropDownButton x:Name="AiButton"
                                Grid.Column="0"
                                Height="22"
                                Padding="8,0"
                                Margin="0,0,10,0"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTipService.ToolTip="Install an AI CLI on this host">
                    <TextBlock Text="AI" Style="{StaticResource CaptionTextBlockStyle}" />
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="AiMenu" Placement="Top" Opening="OnAiMenuOpening" />
                    </DropDownButton.Flyout>
                </DropDownButton>

                <TextBlock x:Name="StatusSession"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="No open sessions" />

                <!--
                    Shown only while the AI auto-answer is on. An automation that answers prompts
                    on the user's behalf has to be visible while it is armed.
                -->
                <TextBlock x:Name="StatusAutoApprove"
                           Grid.Column="2"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="220"
                           Visibility="Collapsed"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           Text="auto-yes" />

                <!-- Round trip to the host and how much the session is actually moving. -->
                <TextBlock x:Name="StatusNetwork"
                           Grid.Column="3"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center"
                           TextWrapping="NoWrap"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="" />

                <!--
                    The font in use, "(auto)" when the app picked it — and the way to change it:
                    the status bar already answers "which font", so it is where the question is asked.
                -->
                <Button x:Name="StatusFontButton"
                        Grid.Column="4"
                        Height="22"
                        Padding="6,0"
                        Margin="0,0,6,0"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTipService.ToolTip="Terminal font and size"
                        Click="OnFontClick">
                    <TextBlock x:Name="StatusFont"
                               TextWrapping="NoWrap"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="" />
                </Button>

                <!-- The IME reading: Kor while the Korean IME is composing Hangul, Eng otherwise. -->
                <Border x:Name="StatusImePill"
                        Grid.Column="5"
                        MinWidth="40"
                        Padding="8,1"
                        CornerRadius="4"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="StatusIme"
                               HorizontalAlignment="Center"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Text="Eng" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
