<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Claret.Dialogs.AboutDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Claret"
    CloseButtonText="Close"
    DefaultButton="Close">

    <ScrollViewer MaxHeight="520">
        <StackPanel Spacing="18" Width="400">

            <StackPanel Spacing="2">
                <TextBlock x:Name="VersionText"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           IsTextSelectionEnabled="True" />
                <TextBlock TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="An SSH and serial console terminal for Windows." />
                <!--
                    Which build this is. Two people on the same version number can be running
                    different binaries, and this is the line that tells them apart.
                -->
                <TextBlock x:Name="BuiltText"
                           Margin="0,4,0,0"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           IsTextSelectionEnabled="True" />
            </StackPanel>

            <StackPanel Spacing="2">
                <TextBlock Text="Made by"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="andro.yoon" IsTextSelectionEnabled="True" />
                <!-- Padding cleared so the link sits on the same left edge as the name above it. -->
                <HyperlinkButton Content="andro78@msn.com"
                                 NavigateUri="mailto:andro78@msn.com"
                                 Padding="0"
                                 HorizontalAlignment="Left" />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="Built with"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <!--
                    Read at run time rather than written down: these are the versions actually
                    loaded, which is the point of showing them. When rendering or a connection
                    misbehaves, this is the first list anyone asks for.
                -->
                <Grid ColumnSpacing="16" RowSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text=".NET"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="RuntimeText" Grid.Row="0" Grid.Column="1"
                               TextWrapping="Wrap" IsTextSelectionEnabled="True" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Windows App SDK"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="WinUiText" Grid.Row="1" Grid.Column="1"
                               TextWrapping="Wrap" IsTextSelectionEnabled="True" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="WebView2"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="WebViewText" Grid.Row="2" Grid.Column="1"
                               TextWrapping="Wrap" IsTextSelectionEnabled="True" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="SSH.NET"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="SshText" Grid.Row="3" Grid.Column="1"
                               TextWrapping="Wrap" IsTextSelectionEnabled="True" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Windows"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="WindowsText" Grid.Row="4" Grid.Column="1"
                               TextWrapping="Wrap" IsTextSelectionEnabled="True" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Running from"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="BaseText" Grid.Row="5" Grid.Column="1"
                               TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                </Grid>
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="Settings and saved connections"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="DataText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                <!-- Saved passwords are the exception, and it is worth saying so where the folder is. -->
                <TextBlock TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Copying this folder carries your settings to another machine. Saved passwords do not travel: they are encrypted for this Windows account." />
                <Button Content="Open folder" Margin="0,4,0,0" Click="OnOpenDataFolderClick" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
