<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Claret.Controls.DetectionsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Claret.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: what the panel is, how many hits, and the two things you can do to it. -->
        <Grid Grid.Row="0" Margin="8,4,4,4" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Text="Detections" />

            <TextBlock x:Name="CountText"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="" />

            <Button Grid.Column="2"
                    Height="26"
                    Padding="8,0"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTipService.ToolTip="Clear the list"
                    Click="OnClearClick">
                <FontIcon Glyph="&#xE894;" FontSize="13" />
            </Button>

            <Button Grid.Column="3"
                    Height="26"
                    Padding="8,0"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTipService.ToolTip="Hide the panel"
                    Click="OnCloseClick">
                <FontIcon Glyph="&#xE711;" FontSize="13" />
            </Button>
        </Grid>

        <!--
            Newest first. A watched line is news, and news that has scrolled off the top of its own
            panel is no use to the person who asked to be told about it.
        -->
        <ListView x:Name="HitList"
                  Grid.Row="1"
                  SelectionMode="Single"
                  IsItemClickEnabled="True"
                  ItemClick="OnHitClick">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:DetectionRow">
                    <Grid Padding="0,4" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{x:Bind Time}"
                                   VerticalAlignment="Center"
                                   FontFamily="Consolas"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                        <!-- Which pane it came from, which is the whole reason the panel exists. -->
                        <TextBlock Grid.Column="1"
                                   Text="{x:Bind Pane}"
                                   VerticalAlignment="Center"
                                   MaxWidth="150"
                                   FontWeight="SemiBold"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   Style="{StaticResource CaptionTextBlockStyle}" />

                        <TextBlock Grid.Column="2"
                                   Text="{x:Bind Line}"
                                   VerticalAlignment="Center"
                                   FontFamily="Consolas"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock x:Name="EmptyState"
                   Grid.Row="1"
                   Margin="12"
                   VerticalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="Nothing detected yet. Tick &quot;Report matching lines&quot; on a rule in Tools to watch for it." />
    </Grid>
</UserControl>
