<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>XCENA_Terminal_Dev</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
  </ItemGroup>

  <!-- xterm.js bundle served to WebView2 through a virtual host mapping -->
  <ItemGroup>
    <Content Include="Assets\xterm\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    An unpackaged publish drops the compiled XAML (*.xbf) and the app resource index (*.pri)
    even though the build produces them, and without those Application.Start fails at startup
    with E_FAIL inside Microsoft.UI.Xaml.dll. Add them back to the publish item list.
  -->
  <Target Name="IncludeXamlArtifactsInPublish" BeforeTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_XamlPublishArtifact Include="$(OutDir)*.xbf" />
      <_XamlPublishArtifact Include="$(OutDir)$(AssemblyName).pri" />
      <ResolvedFileToPublish Include="@(_XamlPublishArtifact)">
        <RelativePath>%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

    <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <!-- SSH.NET resolves crypto algorithms reflectively; trimming strips them. -->
    <PublishTrimmed>False</PublishTrimmed>
  </PropertyGroup>
</Project>