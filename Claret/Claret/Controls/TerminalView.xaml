<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Claret.Controls.TerminalView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--
            The scrim is only for states with nothing behind it worth seeing — connecting, or a
            connect that failed before a byte arrived. Once a session has printed something, that
            output is the most useful thing in the pane and the overlay must not sit on top of it.
        -->
        <SolidColorBrush x:Key="OverlayScrim" Color="#E0101010" />
        <SolidColorBrush x:Key="OverlayCardFill" Color="#F01C1C1C" />
    </UserControl.Resources>

    <Grid>
        <Grid.Background>
            <SolidColorBrush x:Name="TerminalBackground" Color="#0C0C0C" />
        </Grid.Background>
        <WebView2 x:Name="Web" />

        <!--
            Covers the terminal while connecting; steps aside once the session has ended, so what
            it printed stays readable and selectable. With no Background the empty area of this
            Grid does not hit-test, and the mouse reaches the terminal underneath — while the card
            keeps its own, so the buttons on it still work.
        -->
        <Grid x:Name="Overlay"
              Background="{StaticResource OverlayScrim}"
              Visibility="Collapsed">
            <Border x:Name="OverlayCard"
                    Background="{x:Null}"
                    CornerRadius="6"
                    Padding="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="520">
            <StackPanel Spacing="14">
                <ProgressRing x:Name="BusyRing"
                              Width="34"
                              Height="34"
                              IsActive="False"
                              HorizontalAlignment="Center" />
                <FontIcon x:Name="OverlayIcon"
                          Glyph="&#xEA39;"
                          FontSize="30"
                          Foreground="#E88"
                          Visibility="Collapsed"
                          HorizontalAlignment="Center" />
                <TextBlock x:Name="OverlayTitle"
                           Text=""
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#F0F0F0"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="OverlayDetail"
                           Text=""
                           FontSize="12.5"
                           Foreground="#B0B0B0"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           IsTextSelectionEnabled="True" />
                <StackPanel x:Name="OverlayButtons"
                            Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Center">
                    <Button x:Name="RetryButton"
                            Content="Reconnect now"
                            Visibility="Collapsed"
                            Click="OnRetryClick" />
                    <Button x:Name="StopRetryButton"
                            Content="Stop auto-reconnect"
                            Visibility="Collapsed"
                            Click="OnStopRetryClick" />
                </StackPanel>
            </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
